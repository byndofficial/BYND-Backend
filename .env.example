# Copy this file to .env and fill in real values.
# Never commit the real .env file — it is already git-ignored.
# All variables below are checked at boot in src/config/env.js — the
# server refuses to start if any required one is missing.

# ---------- Core ----------
NODE_ENV=development
PORT=5000

# ---------- Database ----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bynd?retryWrites=true&w=majority

# ---------- CORS (exact origins only — no wildcards) ----------
STOREFRONT_ORIGIN=http://localhost:3003
ADMIN_ORIGIN=http://localhost:3004

# ---------- Admin JWT auth ----------
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
# Refresh tokens are opaque random strings (not JWTs), hashed before
# storage in the RefreshToken collection — see src/utils/generateTokens.js
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ---------- Firebase Admin SDK (customer auth: mobile OTP + Google) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n escapes in the private key when pasting into .env
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Cloudinary (media storage) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Razorpay (payments) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Resend (transactional + campaign email) ----------
RESEND_API_KEY=
EMAIL_FROM_SUPPORT="BYND Official <support@byndofficial.in>"
EMAIL_FROM_ORDERS="BYND Orders <orders@byndofficial.in>"
